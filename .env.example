# ---------------------------------------------------------------------------
# LocalShield Hybrid AI — environment template
# Copy to `.env.local` and fill in with YOUR Firebase project values.
# Never commit `.env` / `.env.local`: they are gitignored.
#
# Firebase console: https://console.firebase.google.com/
#   Project settings > General > Your apps > SDK setup and configuration
# ---------------------------------------------------------------------------

# Firebase web app config (all of these are safe-to-expose client identifiers,
# but keep them out of git anyway so each deployment can use its own project).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA Enterprise site key
# Firebase console > Security > App Check > Apps > your web app > reCAPTCHA Enterprise
VITE_APPCHECK_SITE_KEY=

# App Check debug token, for localhost development only.
# Set VITE_APPCHECK_DEBUG=true to have the app generate/print a debug token in
# the browser console; register that token in the Firebase console
# (App Check > Apps > Manage debug tokens). Leave BOTH empty in production.
VITE_APPCHECK_DEBUG=false
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud fallback model (default: gemini-3.5-flash-lite)
# VITE_CLOUD_MODEL=gemini-3.5-flash-lite
